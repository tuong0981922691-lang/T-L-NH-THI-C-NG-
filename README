def test_sha_hmac(tmp_path):
    f = tmp_path / "x.txt"
    f.write_bytes(b"hello")
    sha = compute_sha256(str(f))
    assert sha == "..."  # precomputed
    h = compute_hmac_hex(str(f), "key")
